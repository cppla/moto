{
  "log": {
    "level": "debug",
    "path": "./moto.log",
    "version": "1.0.1",
    "date": "2024-07-23"
  },
  "metrics": {
    "enabled": true,
    "listen": "127.0.0.1:9090"
  },
  "rules": [
    {
      "name": "正常模式",
      "listen": "127.0.0.1:81",
      "mode": "normal",
      "prewarm": false,
      "timeout": 3000,
      "allowlist": ["127.0.0.0/8", "::1/128"],
      "maxConnections": 4096,
      "maxConnectionsPerIP": 1024,
      "blacklist": null,
      "targets": [
        {
          "address": "www.baidu.com:80"
        },
        {
          "address": "www.baidu.com:80"
        }
      ]
    },
    {
      "name": "正则模式",
      "listen": "127.0.0.1:82",
      "mode": "regex",
      "prewarm": false,
      "timeout": 1000,
      "allowlist": ["127.0.0.0/8", "::1/128"],
      "maxConnections": 4096,
      "maxConnectionsPerIP": 1024,
      "blacklist": null,
      "targets": [
        {
          "regexp": "^(GET|POST|HEAD|DELETE|PUT|CONNECT|OPTIONS|TRACE)",
          "address": "www.baidu.com:80"
        },
        {
          "regexp": "^SSH",
          "address": "www.baidu.com:22"
        }
      ]
    },
    {
      "name": "智能加速",
      "listen": "127.0.0.1:83",
      "mode": "boost",
      "prewarm": false,
      "timeout": 3000,
      "allowlist": ["127.0.0.0/8", "::1/128"],
      "maxConnections": 4096,
      "maxConnectionsPerIP": 1024,
      "blacklist": null,
      "targets": [
        {
          "address": "8.130.11.142:85"
        },
        {
          "address": "8.130.55.77:85"
        },
        {
          "address": "8.130.65.34:85"
        },
        {
          "address": "39.104.207.33:85"
        }
      ]
    },
    {
      "name": "轮询模式",
      "listen": "127.0.0.1:84",
      "mode": "roundrobin",
      "prewarm": false,
      "timeout": 3000,
      "allowlist": ["127.0.0.0/8", "::1/128"],
      "maxConnections": 4096,
      "maxConnectionsPerIP": 1024,
      "blacklist": null,
      "targets": [
        {
          "address": "8.130.11.142:85"
        },
        {
          "address": "8.130.55.77:85"
        },
        {
          "address": "8.130.65.34:85"
        },
        {
          "address": "39.104.207.33:85"
        }
      ]
    }
  ]
}
